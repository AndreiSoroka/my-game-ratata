{
    "name": "@my-game-ratata/backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "start:e2e": "bun tests/start-e2e.ts",
        "build": "bun build src/index.ts src/adminCode.ts --target=bun --outdir ../../dist/backend && node ../../scripts/knowledge-build.mjs && node ../../scripts/world-map-build.mjs",
        "type-check": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --config vitest.config.ts",
        "test:watch": "vitest --config vitest.config.ts",
        "lint": "eslint src tests --max-warnings=0"
    },
    "dependencies": {
        "@huggingface/transformers": "4.3.2",
        "@my-game-ratata/contracts": "workspace:*"
    }
}
