{
    "name": "frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 5173",
        "storybook": "storybook dev --host 127.0.0.1 --port 6006",
        "build-storybook": "storybook build",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview --host 127.0.0.1 --port 4173",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "bun run test:e2e:app",
        "test:e2e:all": "run-s test:e2e:app:all test:e2e:graves test:e2e:storybook",
        "test:e2e:app": "bun run test:e2e:app:chromium",
        "test:e2e:app:all": "run-s test:e2e:app:chromium test:e2e:app:firefox test:e2e:app:webkit",
        "test:e2e:app:chromium": "E2E_BROWSER=chromium playwright test --project=chromium",
        "test:e2e:app:firefox": "E2E_BROWSER=firefox playwright test --project=firefox",
        "test:e2e:app:webkit": "E2E_BROWSER=webkit playwright test --project=webkit",
        "test:e2e:engine": "playwright test --config playwright.engine.config.ts",
        "test:e2e:storybook": "playwright test --config playwright.storybook.config.ts",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "run-s lint:oxlint lint:eslint lint:fsd",
        "lint:oxlint": "oxlint .",
        "lint:eslint": "eslint . --cache --cache-location ./node_modules/.tmp/eslint/.eslintcache --max-warnings=0",
        "lint:fsd": "CHOKIDAR_USEPOLLING=1 steiger ./src --config ./steiger.config.js",
        "lint:fix": "run-s lint:fix:oxlint lint:fix:eslint",
        "lint:fix:oxlint": "oxlint . --fix",
        "lint:fix:eslint": "eslint . --fix --cache --cache-location ./node_modules/.tmp/eslint/.eslintcache",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "test:e2e:graves": "run-s test:e2e:graves:desktop test:e2e:graves:mobile",
        "test:e2e:graves:desktop": "E2E_GRAVE_VIEWPORT=desktop playwright test --config playwright.graves.config.ts",
        "test:e2e:graves:mobile": "E2E_GRAVE_VIEWPORT=mobile playwright test --config playwright.graves.config.ts"
    },
    "dependencies": {
        "@my-game-ratata/contracts": "workspace:*",
        "excalibur": "1.0.1",
        "pinia": "^4.1.0",
        "vue": "^3.5.45",
        "vue-i18n": "^11.4.18"
    },
    "devDependencies": {
        "@feature-sliced/steiger-plugin": "0.8.2",
        "@playwright/test": "^1.65.0",
        "@storybook/addon-a11y": "10.6.6",
        "@storybook/addon-docs": "10.6.6",
        "@storybook/web-components-vite": "10.6.6",
        "@tsconfig/node24": "^24.0.5",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/eslint-plugin": "^1.6.28",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-oxlint": "~1.92.0",
        "eslint-plugin-playwright": "^2.12.2",
        "eslint-plugin-vue": "~10.12.0",
        "jiti": "^2.7.0",
        "jsdom": "^31.0.0",
        "npm-run-all2": "^9.0.4",
        "oxlint": "~1.92.0",
        "prettier": "3.9.10",
        "steiger": "0.10.0",
        "storybook": "10.6.6",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.6",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^5.1.0",
        "vue-eslint-parser": "^10.4.2",
        "vue-tsc": "^3.3.14"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}
