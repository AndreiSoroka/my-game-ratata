{
    "name": "my-game-ratata",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "workspaces": [
        "apps/*",
        "contracts"
    ],
    "scripts": {
        "npc:invitations:dialogue": "bun scripts/npc-invitation-dialogue-check.ts",
        "npc:identity:dialogue": "bun scripts/npc-identity-dialogue-check.ts",
        "npc:navigation:dialogue": "bun scripts/npc-navigation-dialogue-check.ts",
        "benchmark:snapshots": "bun scripts/snapshot-network-benchmark.ts",
        "dev:backend": "bun run --cwd apps/backend dev",
        "dev:backend:lan": "bun run --cwd apps/backend start",
        "admin:code": "bun apps/backend/src/adminCode.ts",
        "dev:frontend": "bun run --cwd apps/frontend dev",
        "dev:frontend:lan": "bun run --cwd apps/frontend dev --host 0.0.0.0 --port 4173 --strictPort",
        "dev:lan": "GAME_SERVER_HOST=0.0.0.0 PORT=3000 run-p --race dev:backend:lan dev:frontend:lan",
        "storybook:frontend": "bun run --cwd apps/frontend storybook",
        "build-storybook:frontend": "bun run --cwd apps/frontend build-storybook",
        "build": "run-s build:*",
        "build:backend": "bun run --cwd apps/backend build",
        "build:frontend": "bun run --cwd apps/frontend build",
        "type-check": "run-s type-check:*",
        "type-check:backend": "bun run --cwd apps/backend type-check",
        "type-check:contracts": "bunx tsc -p contracts/tsconfig.json --noEmit",
        "type-check:frontend": "bun run --cwd apps/frontend type-check",
        "lint": "run-s lint:workspace lint:frontend",
        "lint:workspace": "eslint apps/backend contracts --max-warnings=0",
        "lint:frontend": "bun run --cwd apps/frontend lint",
        "lint:fsd": "bun run --cwd apps/frontend lint:fsd",
        "lint:fix": "run-s lint:fix:workspace lint:fix:frontend",
        "lint:fix:workspace": "eslint apps/backend contracts --fix",
        "lint:fix:frontend": "bun run --cwd apps/frontend lint:fix",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "test": "run-s test:backend test:frontend test:agent test:world",
        "test:backend": "bun run --cwd apps/backend test",
        "test:frontend": "bun run --cwd apps/frontend test:unit",
        "test:e2e": "bun run --cwd apps/frontend test:e2e",
        "test:e2e:firefox": "bun run --cwd apps/frontend test:e2e:app:firefox",
        "test:e2e:webkit": "bun run --cwd apps/frontend test:e2e:app:webkit",
        "test:e2e:graves": "bun run --cwd apps/frontend test:e2e:graves",
        "test:e2e:storybook": "bun run --cwd apps/frontend test:e2e:storybook",
        "test:e2e:all": "bun run --cwd apps/frontend test:e2e:all",
        "check": "run-s format type-check lint test build",
        "check:full": "run-s check test:e2e",
        "prepare": "husky",
        "test:agent": "node --test scripts/agent-mcp.test.mjs",
        "test:world": "node --test scripts/generate-pond-interactions.test.mjs scripts/generate-resources.test.mjs scripts/generate-training.test.mjs scripts/generate-city.test.mjs",
        "knowledge:prepare": "node scripts/knowledge-prepare.mjs",
        "translation:prepare": "node scripts/translation-prepare.mjs",
        "translation:smoke": "node scripts/translation-smoke.mjs",
        "knowledge:smoke": "node scripts/knowledge-smoke.mjs",
        "knowledge:check": "bun scripts/knowledge-check.ts",
        "knowledge:dialogue": "bun scripts/knowledge-dialogue-check.ts",
        "npc:style:dialogue": "bun scripts/npc-style-dialogue-check.ts",
        "npc:scout:dialogue": "bun scripts/npc-scout-dialogue-check.ts",
        "npc:offers:dialogue": "bun scripts/npc-offer-dialogue-check.ts",
        "npc:city:dialogue": "bun scripts/npc-city-dialogue-check.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "1.4.4",
        "eslint": "^10.14.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "16.4.0",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0",
        "@typescript/native": "npm:typescript@^7.0.2"
    },
    "engines": {
        "bun": ">=1.4.4"
    }
}
