{
    "name": "my-game-ratata",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "workspaces": [
        "apps/*",
        "contracts"
    ],
    "scripts": {
        "dev:backend": "bun run --cwd apps/backend dev",
        "dev:frontend": "bun run --cwd apps/frontend dev",
        "storybook:frontend": "bun run --cwd apps/frontend storybook",
        "build-storybook:frontend": "bun run --cwd apps/frontend build-storybook",
        "build": "run-s build:*",
        "build:backend": "bun run --cwd apps/backend build",
        "build:frontend": "bun run --cwd apps/frontend build",
        "type-check": "run-s type-check:*",
        "type-check:backend": "bun run --cwd apps/backend type-check",
        "type-check:contracts": "bunx tsc -p contracts/tsconfig.json --noEmit",
        "type-check:frontend": "bun run --cwd apps/frontend type-check",
        "lint": "run-s lint:workspace lint:frontend",
        "lint:workspace": "eslint apps/backend contracts --max-warnings=0",
        "lint:frontend": "bun run --cwd apps/frontend lint",
        "lint:fix": "run-s lint:fix:workspace lint:fix:frontend",
        "lint:fix:workspace": "eslint apps/backend contracts --fix",
        "lint:fix:frontend": "bun run --cwd apps/frontend lint:fix",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "test": "run-s test:backend test:frontend test:agent test:world",
        "test:backend": "bun run --cwd apps/backend test",
        "test:frontend": "bun run --cwd apps/frontend test:unit",
        "test:e2e": "bun run --cwd apps/frontend test:e2e",
        "check": "run-s format type-check lint test build test:e2e",
        "prepare": "husky",
        "test:agent": "node --test scripts/agent-mcp.test.mjs",
        "test:world": "node --test scripts/generate-pond-interactions.test.mjs scripts/generate-resources.test.mjs scripts/generate-training.test.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "1.4.4",
        "eslint": "^10.14.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0",
        "@typescript/native": "npm:typescript@^7.0.2"
    },
    "engines": {
        "bun": ">=1.4.4"
    }
}
